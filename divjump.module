<?php

/**
 * @file
 * DivJump module - Move a div element and insert it between specified views-rows.
 */

use Drupal\Core\Routing\RouteMatchInterface;

/**
 * Implements hook_help().
 */
function divjump_help($route_name, RouteMatchInterface $route_match) {
  switch ($route_name) {
    case 'help.page.divjump':
      $output  = '<h2>' . t('About DivJump') . '</h2>';
      $output .= '<p>' . t('The DivJump module moves a div element (e.g. an Ad block) and inserts it between specified views-rows without editing templates directly.') . '</p>';
      $output .= '<h2>' . t('How to use') . '</h2>';
      $output .= '<ol>';
      $output .= '<li>' . t('Go to <strong>Administration » Configuration » User Interface » DivJump</strong>') . '</li>';
      $output .= '<li>' . t('Click <strong>"+ Add Div"</strong>, then enter the <strong>Div ID</strong> and the <strong>row position</strong> where it should be inserted.') . '</li>';
      $output .= '<li>' . t('Multiple Div entries are supported — each entry has its own row position.') . '</li>';
      $output .= '<li>' . t('Configure <strong>Page Visibility</strong> to control which pages this module runs on.') . '</li>';
      $output .= '<li>' . t('Click <strong>Save</strong> and clear the cache.') . '</li>';
      $output .= '</ol>';
      $output .= '<h2>' . t('Notes') . '</h2>';
      $output .= '<ul>';
      $output .= '<li>' . t('Row position is 1-based. e.g. entering 3 inserts the div after row 3 (between row 3 and row 4).') . '</li>';
      $output .= '<li>' . t('If the number of .views-row elements is less than the specified position, that entry is skipped.') . '</li>';
      $output .= '<li>' . t('Only <code>.views-row</code> class from Drupal Views is supported.') . '</li>';
      $output .= '</ul>';
      return $output;
  }
}

/**
 * Implements hook_page_attachments().
 */
function divjump_page_attachments(array &$attachments) {
  $config = \Drupal::config('divjump.settings');
  $divs   = $config->get('divs') ?? [];

  // Filter entries that have both div_id and row_position.
  $active_divs = array_values(array_filter($divs, function ($div) {
    return !empty($div['div_id']) && !empty($div['row_position']);
  }));

  if (empty($active_divs)) {
    return;
  }

  // ── Page Visibility check ────────────────────────────────────────────────
  $visibility_type = (int) ($config->get('page_visibility.type') ?? 0);
  $pages           = trim($config->get('page_visibility.pages') ?? '');

  if (!empty($pages)) {
    $current_path = \Drupal::service('path.current')->getPath();
    $alias        = \Drupal::service('path_alias.manager')->getAliasByPath($current_path);
    $path_matcher = \Drupal::service('path.matcher');

    $match = $path_matcher->matchPath($current_path, $pages)
          || ($alias !== $current_path && $path_matcher->matchPath($alias, $pages));

    // type=0 → all pages except listed  → stop if matched
    // type=1 → only listed pages        → stop if not matched
    if ($visibility_type === 0 && $match) {
      return;
    }
    if ($visibility_type === 1 && !$match) {
      return;
    }
  }
  elseif ($visibility_type === 1) {
    // type=1 but no pages entered → show nowhere
    return;
  }

  // ── Attach JS ────────────────────────────────────────────────────────────
  $attachments['#attached']['library'][]                 = 'divjump/divjump';
  $attachments['#attached']['drupalSettings']['divjump'] = [
    'divs' => $active_divs,
  ];
}
